{
  "name": "recordweb",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "desktop": "electron .",
    "desktop:smoke": "electron . --cursor-helper-smoke",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "db:status": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs status",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs migrate",
    "db:verify": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs verify"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.14",
    "@mediapipe/selfie_segmentation": "0.1.1675465747",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.1",
    "fix-webm-duration": "^1.0.6",
    "idb-keyval": "^6.3.0",
    "mediabunny": "^1.61.2",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "pptx-browser": "4.1.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "typescript": "^5"
  }
}
