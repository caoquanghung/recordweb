{
  "manifest_version": 3,
  "name": "RecordWeb Presentation Cursor",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Track the cursor in a Google Slides presentation while RecordWeb records the user-selected shared tab.",
  "homepage_url": "https://recordweb-nine.vercel.app/",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://recordweb-nine.vercel.app/*",
    "https://*.vercel.app/*",
    "https://docs.google.com/presentation/*"
  ],
  "action": {
    "default_title": "Open RecordWeb"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://recordweb-nine.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["recordweb-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["tracker-content.js"],
      "run_at": "document_start"
    }
  ]
}
